# ==========================================
# FASTIGO CAREER MANAGEMENT SYSTEM - CONFIG TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to Git or GitHub!
# ==========================================

# 1. MongoDB Connection String (Atlas Cloud Cluster or Local MongoDB):
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
# Example Local: mongodb://127.0.0.1:27017
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=fastigo_careers

# 2. Frontend API Base URL (proxied through Vite in dev)
VITE_API_URL=/api

# 3. Security & JWT:
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Default Admin Initial Account (seeded by init_db.py):
DEFAULT_ADMIN_EMAIL=admin@fastigo.co
DEFAULT_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
DEFAULT_ADMIN_NAME=Fastigo Talent Admin

# 5. Cloudinary Configuration (Candidate Resume & Document Uploads):
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Vite Client-accessible Cloudinary keys:
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
