# ==========================================
# FASTIGO BACKEND CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the real '.env' file to Git or GitHub!
# ==========================================

# MongoDB Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
DB_NAME=fastigo_careers

# Security & JWT
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@fastigo.co
DEFAULT_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
DEFAULT_ADMIN_NAME=Fastigo Talent Admin

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
